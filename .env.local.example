# Resend API key — used by the /api/contact route to send contact form emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The address contact-form submissions are delivered to.
CONTACT_TO_EMAIL=hello@peterantoun.com

# Verified sender address on your Resend account (must be a verified domain).
CONTACT_FROM_EMAIL=Portfolio <contact@peterantoun.com>

# ── Finance dashboard (/admin) ────────────────────────────────────────────
# Postgres connection string. Use Vercel Postgres / Neon. The pooled
# ("-pooler") URL is recommended for the serverless runtime.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Secret used to sign the admin session cookie (JWT). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Shared secret guarding the cron endpoints (/api/cron/*). Vercel Cron sends
# it as the Authorization: Bearer <secret> header. Generate with:
#   openssl rand -hex 32
CRON_SECRET=change-me

# Base currency all totals are converted to. USD or EUR.
BASE_CURRENCY=USD
